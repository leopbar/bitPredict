# ─── Database ──────────────────────────────────────────────────────────────
POSTGRES_USER=bitpredict
POSTGRES_PASSWORD=CHANGE_ME_TO_A_STRONG_PASSWORD
POSTGRES_DB=bitpredict

# ─── Backend ───────────────────────────────────────────────────────────────
LOG_LEVEL=INFO

# MLflow tracking — set to a real URL once MLflow is deployed, otherwise leave
# this placeholder. The backend just needs the setting to exist; it doesn't
# crash if MLflow itself is unreachable.
MLFLOW_TRACKING_URI=http://localhost:5000
# Long random secret used by the backend API and injected server-side by the frontend proxy
API_KEY=CHANGE_ME_TO_A_LONG_RANDOM_STRING

# ─── Flower monitoring (Celery) ────────────────────────────────────────────
# Credentials for the Flower UI basic auth (format: user:password).
# Flower is NOT exposed publicly in production — access via SSH tunnel:
#   ssh -L 5555:localhost:5555 user@vps  →  then open http://localhost:5555
FLOWER_BASIC_AUTH=admin:CHANGE_ME_TO_A_STRONG_PASSWORD

# Comma-separated list of origins allowed by CORS on the backend.
# The backend is NOT publicly exposed in production (no host port mapping).
# All browser traffic goes through the Next.js frontend proxy, so only the
# frontend container needs to be listed here.
API_CORS_ORIGINS=http://bitpredict-frontend:3000

# ─── Binance Data Source ───────────────────────────────────────────────────
# Public market-data mirror. Use this instead of api.binance.com when the VPS
# is geo-blocked (HTTP 451). data-api.binance.vision is Binance's official
# public market data endpoint — only supports unauthenticated read-only
# endpoints (klines, ticker, depth), which is all we need for Kronos.
# For trading or authenticated endpoints, you'd need api.binance.us instead.
BINANCE_BASE_URL=https://data-api.binance.vision

# ─── Frontend ──────────────────────────────────────────────────────────────
# The frontend proxies all API calls server-side (no public backend URL needed).
# NEXT_PUBLIC_API_URL was removed — the proxy reads API_KEY and API_URL internally.
