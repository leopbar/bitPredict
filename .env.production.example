# ─── Database ──────────────────────────────────────────────────────────────
POSTGRES_USER=bitpredict
POSTGRES_PASSWORD=CHANGE_ME_TO_A_STRONG_PASSWORD
POSTGRES_DB=bitpredict

# ─── Backend ───────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
# Long random secret used by the frontend to authenticate against the backend
API_KEY=CHANGE_ME_TO_A_LONG_RANDOM_STRING

# Comma-separated list of origins allowed by CORS.
# Add the public URL of the frontend here.
API_CORS_ORIGINS=http://72.62.96.223:3005

# ─── Frontend ──────────────────────────────────────────────────────────────
# URL the browser uses to reach the backend. Must be publicly reachable.
# When you switch to a domain, replace with https://your-domain.tld
NEXT_PUBLIC_API_URL=http://72.62.96.223:8004
