DATABASE_URL=postgresql+psycopg://bitpredict:bitpredict@db:5432/bitpredict
REDIS_URL=redis://redis:6379/0
MLFLOW_TRACKING_URI=http://mlflow:5000
LOG_LEVEL=INFO
ENVIRONMENT=dev

# API
API_KEY=dev-secret-key
API_CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# SMTP (dev uses MailHog; set to real SMTP values for prod)
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=bitpredict@localhost
SMTP_TLS=false

# Reporting
REPORTS_DIR=/app/data/reports
AUTO_REPORTS_ENABLED=false
AUTO_REPORTS_EMAIL=

# Celery
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2
